<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<title>Relatório Consolidado</title>
<style>
    @page { size: A4 portrait; margin: 15mm; }
    body { font-family: 'Segoe UI', Arial, sans-serif; color: #333; line-height: 1.35; margin: 0; font-size: 10px; }
    .capa { text-align: center; padding-top: 60mm; page-break-after: always; }
    .capa .logo { max-height: 80px; margin-bottom: 20px; }
    .capa .faixa { background: #003366; color: white; padding: 35px 0; margin: 15px -15mm 30px -15mm; }
    .capa h1 { color: white; margin: 0; font-size: 30px; letter-spacing: 4px; }
    .capa h2 { color: white; margin: 8px 0 0 0; font-size: 14px; font-weight: normal; }
    .capa .entidade { font-size: 14px; color: #555; margin: 20px 0; }
    .capa .info { background: #f4f6f9; border-left: 5px solid #0056b3; padding: 15px 40px; margin: 15px auto; max-width: 400px; text-align: left; }
    .capa .info .label { font-size: 10px; color: #666; text-transform: uppercase; }
    .capa .info .valor { font-size: 18px; font-weight: bold; color: #003366; margin-top: 5px; }
    .capa .rodape { color: #999; font-size: 10px; margin-top: 50px; }
    h2.secao-titulo { color: #003366; border-bottom: 3px solid #003366; padding-bottom: 6px; page-break-before: always; font-size: 18px; margin-bottom: 12px; }
    h3.sub { color: #0056b3; font-size: 11px; margin: 12px 0 6px 0; border-bottom: 1px solid #ddd; padding-bottom: 3px; }
    .desc { font-size: 9px; color: #666; margin-bottom: 8px; font-style: italic; }
    table { width: 100%; border-collapse: collapse; margin: 8px 0; }
    th { background: #003366; color: white; padding: 5px; text-align: left; font-size: 8px; text-transform: uppercase; border: 1px solid #003366; }
    td { padding: 4px 5px; border: 1px solid #ddd; font-size: 8.5px; }
    td.right { text-align: right; }
    td.center { text-align: center; }
    tr:nth-child(even) { background: #f8f9fa; }
    tr.total { font-weight: bold; background: #e9ecef; }
</style>
</head>
<body>
<div class="capa">
    <img src="logo" class="logo">
    <div class="faixa"><h1>RELATÓRIO CONSOLIDADO</h1><h2>Análise Contábil</h2></div>
    <div class="entidade">COFEN - Conselho Federal de Enfermagem</div>
    <div class="info"><div class="label">Período de Análise</div><div class="valor">{periodo}</div></div>
    <div class="rodape">Gerado em: {data_geracao}<br>SGPC - Sistema de Gestão de Prestação de Contas</div>
</div>
<div id="conteudo"></div>
<script>
const D = {dados_json};
function moeda(v) { if (!v && v !== 0) return 'R$ 0,00'; return 'R$ ' + parseFloat(v).toLocaleString('pt-BR', {minimumFractionDigits: 2, maximumFractionDigits: 2}); }
function pct(v) { if (v === null || v === undefined) return '0,00%'; return parseFloat(v).toLocaleString('pt-BR', {minimumFractionDigits: 2, maximumFractionDigits: 2}) + '%'; }
function tit(n, t) { return '<h2 class="secao-titulo">' + n + '. ' + t + '</h2>'; }
function sub(t) { return '<h3 class="sub">' + t + '</h3>'; }
function tab(headers, rows) {
    if (!rows.length) return '<p style="color:#999">Sem dados.</p>';
    let h = '<table><thead><tr>';
    headers.forEach((x,i) => h += '<th' + (i>0?' style="text-align:right"':'') + '>' + x + '</th>');
    h += '</tr></thead><tbody>';
    rows.forEach(r => { h += '<tr>'; r.forEach((c,i) => h += '<td' + (i>0?' class="right"':'') + '>' + (c??'-') + '</td>'); h += '</tr>'; });
    return h + '</tbody></table>';
}
function unwrap(mod) { return mod && mod.dados !== undefined ? mod.dados : mod; }
let H = '';

// (Aqui entram as seções 1 a 11, idênticas ao seu código original que funcionava)
// ===== 1. INTEGRIDADE =====
H += tit(1, 'Integridade entre Demonstrações');
H += '<div class="desc">Matriz de integridade com o cruzamento de todas as demonstrações.</div>';
const integ = unwrap(D.integridade);
if (integ && integ.matriz) {
    const rows = integ.matriz.map(m => [m.item || '-', m.balancete || '-', m.bp || '-', m.bf || '-', m.bo || '-', m.dfc || '-', m.dvp || '-', m.dmpl || '-', m.conf || '-']);
    H += tab(['Item','Balancete','BP','BF','BO','DFC','DVP','DMPL','Conf.'], rows);
} else { H += '<p>Módulo não encontrado.</p>'; }

// ===== 2. ANÁLISE BP =====
H += tit(2, 'Análise do Balanço Patrimonial');
H += '<div class="desc">Comparativo das contas do Balanço Patrimonial (período atual x anterior).</div>';

// --- INÍCIO DO DEBUG ---
H += '<div style="border: 2px solid red; padding: 10px; background: #fff; font-family: monospace; font-size: 12px; color: black;">';
H += '<h3 style="color: red; margin-top: 0;">DEBUG DO BALANÇO PATRIMONIAL</h3>';
try {
    const bpRaw = unwrap(D.analise_bp) || D.balanco_patrimonial || D.bp;
    if (bpRaw) {
        H += '<b>O objeto D.analise_bp existe!</b><br><br>';
        H += '<b>Chaves encontradas:</b> ' + Object.keys(bpRaw).join(', ') + '<br><br>';
        H += '<b>Conteúdo completo (primeiros 1000 caracteres):</b><br>';
        H += '<pre style="white-space: pre-wrap;">' + JSON.stringify(bpRaw, null, 2).substring(0, 1000) + '...</pre>';
    } else {
        H += '<b style="color:red;">ERRO: O objeto D.analise_bp está vazio ou não existe no JSON!</b><br>';
        H += 'Chaves disponíveis em D: ' + Object.keys(D).join(', ');
    }
} catch (e) {
    H += '<b style="color:red;">ERRO DE JAVASCRIPT:</b> ' + e.message;
}
H += '</div>';
// --- FIM DO DEBUG ---

// ===== 3. ANÁLISE BO =====
H += tit(3, 'Análise do Balanço Orçamentário');
H += '<div class="desc">Comparativo das receitas e despesas.</div>';
const bo = unwrap(D.analise_orcamentaria);
if (bo) {
    const rows = [];
    [['Receita Realizada','receita_realizada'],['Despesa Empenhada','despesa_empenhada'],['Superávit/Déficit','superavit'],['Restos a Pagar','restos_pagar'],['Receita Orçada','receita_orcada'],['Despesa Orçada','despesa_orcada'],['% Realização Receitas','pct_receita'],['% Realização Despesas','pct_despesa']].forEach(([l,k]) => {
        rows.push([l, moeda(bo.atual ? bo.atual[k] : null), moeda(bo.anterior ? bo.anterior[k] : null)]);
    });
    H += tab(['Indicador','Atual','Anterior'], rows);
} else { H += '<p>Módulo não encontrado.</p>'; }

// ===== 4. ANÁLISE BF =====
H += tit(4, 'Análise do Balanço Financeiro');
H += '<div class="desc">Movimentação financeira.</div>';
const bf = unwrap(D.analise_financeira_bf);
if (bf) {
    const rows = [];
    [['receitas', bf.receitas],['despesas', bf.despesas],['extra', bf.extra],['caixa', bf.caixa]].forEach(([t, obj]) => {
        if (obj) Object.keys(obj).forEach(k => { if (obj[k] && obj[k].atual !== undefined) rows.push([k.replace(/_/g,' ').toUpperCase(), moeda(obj[k].atual), moeda(obj[k].anterior)]); });
    });
    H += tab(['Item','Atual','Anterior'], rows);
} else { H += '<p>Módulo não encontrado.</p>'; }

// ===== 5. ANÁLISE DFC =====
H += tit(5, 'Análise do Fluxo de Caixa');
H += '<div class="desc">Demonstração do Fluxo de Caixa.</div>';
const dfc = unwrap(D.analise_dfc);
if (dfc) {
    const rows = [];
    ['operacional', 'investimento', 'financiamento', 'caixa'].forEach(k => {
        if (dfc[k] && typeof dfc[k] === 'object') {
            Object.keys(dfc[k]).forEach(key => {
                if (dfc[k][key] && dfc[k][key].atual !== undefined) rows.push([key.replace(/_/g,' ').toUpperCase(), moeda(dfc[k][key].atual), moeda(dfc[k][key].anterior)]);
            });
        }
    });
    H += tab(['Item','Atual','Anterior'], rows);
} else { H += '<p>Módulo não encontrado.</p>'; }

// ===== 6. ANÁLISE DVP =====
H += tit(6, 'Análise das Variações Patrimoniais');
H += '<div class="desc">Demonstração das Variações Patrimoniais.</div>';
const dvp = unwrap(D.analise_patrimonial);
if (dvp) {
    const rows = [];
    ['variacoes_ativas','transf_recebidas','reversao_provisoes','variacoes_diminutivas','pessoal_encargos','servicos_terceiros','transf_concedidas','superavit_patrimonial','margem_patrimonial'].forEach(k => {
        if (dvp[k]) rows.push([k.replace(/_/g,' ').toUpperCase(), moeda(dvp[k].atual), moeda(dvp[k].anterior)]);
    });
    H += tab(['Item','Atual','Anterior'], rows);
} else { H += '<p>Módulo não encontrado.</p>'; }

// ===== 7. RECEITAS =====
H += tit(7, 'Comparativo de Receitas');
H += '<div class="desc">Comparativo consolidado.</div>';
const crec = unwrap(D.comparativo_receitas);
if (crec) {
    const at = crec.atual || {};
    H += sub('Resumo');
    H += tab(['Indicador','Valor'], [['Receita Orçada', moeda(at.orcado_total)], ['Receita Realizada', moeda(at.realizado_total)], ['% Execução', pct(at.percentual_total)]]);
    if (at.cores) {
        H += sub('Desdobramento por Regional');
        const mapa = new Map();
        at.cores.forEach(c => {
            const key = (c.nome || 'N/I').toUpperCase();
            if (!mapa.has(key)) mapa.set(key, { n: c.nome, o: 0, r: 0 });
            const item = mapa.get(key); item.o += (c.orcado || 0); item.r += (c.realizado || 0);
        });
        const rows = [];
        [...mapa.values()].sort((a,b) => a.n.localeCompare(b.n)).forEach(i => rows.push([i.n, moeda(i.o), moeda(i.r), pct(i.o ? (i.r/i.o*100) : 0)]));
        H += tab(['Regional','Orçado','Realizado','%'], rows);
    }
} else { H += '<p>Módulo não encontrado.</p>'; }

// ===== 8. DESPESAS =====
H += tit(8, 'Comparativo de Despesas');
H += '<div class="desc">Comparativo consolidado.</div>';
const cdesp = unwrap(D.comparativo_despesas);
if (cdesp) {
    const at = cdesp.atual || {};
    H += sub('Resumo');
    H += tab(['Indicador','Valor'], [['Despesa Orçada', moeda(at.orcado_total)], ['Despesa Empenhada', moeda(at.empenhado_total)], ['Despesa Liquidada', moeda(at.liquidado_total)], ['% Execução', pct(at.percentual_total)]]);
} else { H += '<p>Módulo não encontrado.</p>'; }

// ===== 9. LIQUIDEZ =====
H += tit(9, 'Índices de Liquidez e Estrutura');
H += '<div class="desc">Indicadores de liquidez.</div>';
const liq = unwrap(D.liquidez);
if (liq) {
    H += sub('Liquidez');
    const rows = [];
    if (liq.liquidez) [['Liquidez Imediata','liquidez_imediata'], ['Liquidez Corrente','liquidez_corrente'], ['Liquidez Seca','liquidez_seca'], ['Liquidez Geral','liquidez_geral']].forEach(([l,k]) => { if (liq.liquidez[k] !== undefined) rows.push([l, liq.liquidez[k]]); });
    H += tab(['Indicador','Valor'], rows);
    if (liq.estrutura) {
        H += sub('Estrutura');
        const rowsE = [];
        [['Endividamento Geral','endividamento_geral'], ['Part. Capital de Terceiros','part_capital_terceiros'], ['Imobilização do PL','imobilizacao_pl']].forEach(([l,k]) => { if (liq.estrutura[k] !== undefined) rowsE.push([l, liq.estrutura[k] + '%']); });
        H += tab(['Indicador','Valor'], rowsE);
    }
    if (liq.valores) {
        H += sub('Valores Base');
        const rowsV = [];
        Object.keys(liq.valores).forEach(k => rowsV.push([k.replace(/_/g,' ').toUpperCase(), moeda(liq.valores[k])]));
        H += tab(['Item','Valor'], rowsV);
    }
} else { H += '<p>Módulo não encontrado.</p>'; }

// ===== 10. PANORAMA =====
H += tit(10, 'Panorama de Resultados');
H += '<div class="desc">Resumo executivo.</div>';
const pan = unwrap(D.panorama);
if (pan) {
    const rows = [];
    ['ativo_total','passivo_total','patrimonio_liquido','caixa_bp','receita_realizada','despesa_empenhada','superavit_orcamentario','superavit_patrimonial','superavit_financeiro'].forEach(k => { if (pan[k] !== undefined) rows.push([k.replace(/_/g,' ').toUpperCase(), moeda(pan[k])]); });
    H += tab(['Indicador','Valor'], rows);
} else { H += '<p>Módulo não encontrado.</p>'; }

// ===== 11. CENTRO DE CUSTOS =====
H += tit(11, 'Análise por Centro de Custos');
H += '<div class="desc">Distribuição das despesas.</div>';
const cc = unwrap(D.centro_custos);
if (cc && cc.centros) {
    const mapa = {};
    (cc.centros || []).forEach(x => { mapa[x.nome] = {at: x.valor, an: 0}; });
    (cc.centros_anterior || []).forEach(x => { if (mapa[x.nome]) mapa[x.nome].an = x.valor; else mapa[x.nome] = {at: 0, an: x.valor}; });
    const rows = [];
    let tA = 0, tB = 0;
    Object.keys(mapa).sort().forEach(n => {
        const {at: va, an: vb} = mapa[n];
        tA += va; tB += vb;
        rows.push([n, moeda(va), moeda(vb), pct(vb ? ((va-vb)/Math.abs(vb))*100 : 0)]);
    });
    rows.push(['TOTAL', moeda(tA), moeda(tB), pct(tB ? ((tA-tB)/Math.abs(tB))*100 : 0)]);
    H += tab(['Centro de Custo','Atual','Anterior','Variação'], rows);
} else { H += '<p>Módulo não encontrado.</p>'; }

document.getElementById('conteudo').innerHTML = H;
</script>
</body>
</html>