            const line = (label, va, vb, bold) => {
                const v = pct(va, vb);
                const cls = v >= 0 ? 'pos' : 'neg';
                const sg = v >= 0 ? '+' : '';
                const trStyle = bold ? 'font-weight:bold;' : '';
                return '<tr style="' + trStyle + '">' +
                    '<td>' + label + '</td>' +
                    '<td style="text-align:right;">' + fmtV(va) + '</td>' +
                    '<td style="text-align:right;">' + fmtV(vb) + '</td>' +
                    '<td class="' + cls + '" style="text-align:right;">' + sg + fmtP(v) + '</td>' +
                '</tr>';
            };
            const header = (label, color) => '<tr style="background:' + color + '; font-weight:bold; color:#fff;"><td colspan="4">' + label + '</td></tr>';
            const blank = () => '<tr><td colspan="4" style="height:5px; border:none;"></td></tr>';
            const R = {
                rec: {
                    corr: safe(at.receitas && at.receitas.corrente),
                    cap: safe(at.receitas && at.receitas.capital),
                    tot: safe(at.receitas && at.receitas.total),
                },
                desp: {
                    corr: safe(at.despesas && at.despesas.corrente),
                    cap: safe(at.despesas && at.despesas.capital),
                    tot: safe(at.despesas && at.despesas.total),
                },
                extra: {
                    rec: safe(at.extra && at.extra.recebimentos),
                    pag: safe(at.extra && at.extra.pagamentos),
                },
                caixa: {
                    ant: safe(at.caixa && at.caixa.saldo_anterior),
                    ger: safe(at.caixa && at.caixa.geracao_liquida),
                    seg: safe(at.caixa && at.caixa.saldo_seguinte),
                }
            };
            let out = '';
            out += header('RECEITAS', '#003366');
            out += line('Receitas Correntes', R.rec.corr.atual, R.rec.corr.anterior);
            out += line('Receitas de Capital', R.rec.cap.atual, R.rec.cap.anterior);
            out += line('Total de Receitas', R.rec.tot.atual, R.rec.tot.anterior, true);
            out += blank();
            out += header('DESPESAS', '#dc3545');
            out += line('Despesas Correntes', R.desp.corr.atual, R.desp.corr.anterior);
            out += line('Despesas de Capital', R.desp.cap.atual, R.desp.cap.anterior);
            out += line('Total de Despesas', R.desp.tot.atual, R.desp.tot.anterior, true);
            out += blank();
            out += header('EXTRAORCAMENTARIO', '#6c757d');
            out += line('Recebimentos Extraorcamentarios', R.extra.rec.atual, R.extra.rec.anterior);
            out += line('Pagamentos Extraorcamentarios', R.extra.pag.atual, R.extra.pag.anterior);
            out += blank();
            out += header('CAIXA E EQUIVALENTES', '#28a745');
            out += line('Saldo em Especie do Exerc. Anterior', R.caixa.ant.atual, R.caixa.ant.anterior);
            out += line('Geracao Liquida de Caixa', R.caixa.ger.atual, R.caixa.ger.anterior, true);
            out += line('Saldo em Especie para o Exerc. Seguinte', R.caixa.seg.atual, R.caixa.seg.anterior, true);
            tb.innerHTML = out;
            const ctx = document.getElementById('graf');
            if (!ctx) return;
            if (typeof chart !== 'undefined' && chart) chart.destroy();
            const chartCtx = ctx.getContext ? ctx.getContext('2d') : ctx;
            window.chart = new Chart(chartCtx, {
                type: 'bar',
                data: {
                    labels: ['Receitas', 'Despesas', 'Saldo Ant.', 'Saldo Seg.'],
                    datasets: [
                        {
                            label: 'Receitas (Atual)',
                            data: [R.rec.tot.atual, null, null, null],
                            backgroundColor: '#003366',
                            borderColor: '#002244',
                            borderWidth: 1, borderRadius: 6, barPercentage: 0.6
                        },
                        {
                            label: 'Despesas (Atual)',
                            data: [null, R.desp.tot.atual, null, null],
                            backgroundColor: '#dc3545',
                            borderColor: '#a71d2a',
                            borderWidth: 1, borderRadius: 6, barPercentage: 0.6
                        },
                        {
                            label: 'Saldo Ant. (Atual)',
                            data: [null, null, R.caixa.ant.atual, null],
                            backgroundColor: '#4a90e2',
                            borderColor: '#2c6fbb',
                            borderWidth: 1, borderRadius: 6, barPercentage: 0.6
                        },
                        {
                            label: 'Saldo Seg. (Atual)',
                            data: [null, null, null, R.caixa.seg.atual],
                            backgroundColor: '#28a745',
                            borderColor: '#1e7e34',
                            borderWidth: 1, borderRadius: 6, barPercentage: 0.6
                        },
                        {
                            label: 'Receitas (Anterior)',
                            data: [R.rec.tot.anterior, null, null, null],
                            backgroundColor: '#4a90e2',
                            borderColor: '#357abd',
                            borderWidth: 1, borderRadius: 6, barPercentage: 0.6
                        },
                        {
                            label: 'Despesas (Anterior)',
                            data: [null, R.desp.tot.anterior, null, null],
                            backgroundColor: '#e68a8a',
                            borderColor: '#c96b6b',
                            borderWidth: 1, borderRadius: 6, barPercentage: 0.6
                        },
                        {
                            label: 'Saldo Ant. (Anterior)',
                            data: [null, null, R.caixa.ant.anterior, null],
                            backgroundColor: '#90c2e7',
                            borderColor: '#6ba8d4',
                            borderWidth: 1, borderRadius: 6, barPercentage: 0.6
                        },
                        {
                            label: 'Saldo Seg. (Anterior)',
                            data: [null, null, null, R.caixa.seg.anterior],
                            backgroundColor: '#7ec87e',
                            borderColor: '#5fa85f',
                            borderWidth: 1, borderRadius: 6, barPercentage: 0.6
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { position: 'bottom' } }
                }
            });
        }
</script>

    


    


    


    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const btnPdf = document.getElementById('btn-pdf-unico');
            
            if (btnPdf) {
                btnPdf.addEventListener('click', function() {
                    const sel = document.querySelector('input[type="checkbox"]:checked') || 
                                document.querySelector('input[type="radio"]:checked');
                    
                    if (!sel) {
                        alert("Atenção: Selecione um item do Histórico Salvo (marque a caixinha) antes de gerar o PDF.");
                        return;
                    }
                    
                    let id = sel.value;
                    if (!id || id === "on") {
                        id = sel.id.replace('check-', '').replace('hist-', '');
                        if (!id) id = sel.getAttribute('data-id');
                    }
                    
                    // ROTA CORRETA: O ID vai no path da URL, não como query string
                    const url = `/gerar_pdf_analise_dfc/${id}`;
                    console.log("[DEBUG] Abrindo PDF com ID no path:", url);
                    
                    const a = document.createElement('a');
                    a.href = url;
                    a.target = '_blank';
                    document.body.appendChild(a);
                    a.click();
                    document.body.removeChild(a);
                });
                console.log("[DEBUG] Botão PDF configurado para a rota correta!");
            }
        });
    </script>

