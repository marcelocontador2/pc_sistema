<script src="https://cdn.jsdelivr.net/npm/chart.js">function exibirSelecionado() {
            const check = document.querySelector(".check-hist:checked");
            if (!check) { alert("Selecione um item no histórico."); return; }
            fetch('/historico_analise_dfc/' + check.value)
                .then(r => r.json())
                .then(resp => {
                    if (resp.periodo_atual) {
                        // Extrai o período atual salvo (ex: 2026-TRIMESTRE-3)
                        const periodoSalvo = resp.periodo_atual;
                        // Reconstrói os selects (ano, tipo, val) com base no período
                        const partes = periodoSalvo.split('-');
                        if (partes.length === 3) {
                            document.getElementById('ano').value = partes[0];
                            document.getElementById('tipo').value = partes[1];
                            document.getElementById('val').value = partes[2];
                        }
                        // Chama a mesma função do botão "Verificar" para recalcular e desenhar
                        // Isso garante que os dados do período anterior sejam buscados novamente
                        carregar(); 
                    }
                })
                .catch(e => alert("Erro ao carregar o histórico: " + e.message));
        }
        function render(at, ant) {
            const tb = document.querySelector('#tab tbody');
            const fmtV = v => (v || 0).toLocaleString('pt-BR', {minimumFractionDigits: 2, maximumFractionDigits: 2});
            const fmtP = v => (v || 0).toLocaleString('pt-BR', {minimumFractionDigits: 2, maximumFractionDigits: 2}) + '%';
            const pct = (a, b) => b !== 0 ? ((a - b) / Math.abs(b)) * 100 : 0;
            
            const safe = (v) => (v && typeof v === 'object') ? v : {atual: 0, anterior: 0};
            
            const line = (label, va, vb, bold) => {
                const v = pct(va, vb);
                const cls = v >= 0 ? 'pos' : 'neg';
                const sg = v >= 0 ? '+' : '';
                const trStyle = bold ? 'font-weight:bold;' : '';
                return '<tr style="' + trStyle + '">' +
                    '<td>' + label + '</td>' +
                    '<td style="text-align:right;">' + fmtV(va) + '</td>' +
                    '<td style="text-align:right;">' + fmtV(vb) + '</td>' +
                    '<td class="' + cls + '" style="text-align:right;">' + sg + fmtP(v) + '</td>' +
                '</tr>';
            };
            
            const header = (label, color) => '<tr style="background:' + color + '; font-weight:bold; color:#fff;"><td colspan="4">' + label + '</td></tr>';
            
            const at_dados = at.dados || at;
            const ant_dados = ant.dados || ant;

            const op = safe(at_dados.operacional);
            const inv = safe(at_dados.investimento);
            const fin = safe(at_dados.financiamento);
            const cxa = safe(at_dados.caixa);

            let html = '';

            // --- OPERACIONAL ---
            html += header('FLUXO DE CAIXA DAS ATIVIDADES DAS OPERAÇÕES', '#0056b3');
            html += line('Ingressos Operacionais', op.ingressos.atual, op.ingressos.anterior, false);
            html += line('Desembolsos Operacionais', op.desembolsos.atual, op.desembolsos.anterior, false);
            html += line('Caixa Líquido das Operações', op.liquido.atual, op.liquido.anterior, true);
            html += blank();

            // --- INVESTIMENTO ---
            html += header('FLUXO DE CAIXA DAS ATIVIDADES DE INVESTIMENTO', '#e68a8a');
            html += line('Ingressos de Investimento', inv.ingressos.atual, inv.ingressos.anterior, false);
            html += line('Desembolsos de Investimento', inv.desembolsos.atual, inv.desembolsos.anterior, false);
            html += line('Caixa Líquido de Investimento', inv.liquido.atual, inv.liquido.anterior, true);
            html += blank();

            // --- FINANCIAMENTO ---
            html += header('FLUXO DE CAIXA DAS ATIVIDADES DE FINANCIAMENTO', '#dc3545');
            html += line('Ingressos de Financiamento', fin.ingressos.atual, fin.ingressos.anterior, false);
            html += line('Desembolsos de Financiamento', fin.desembolsos.atual, fin.desembolsos.anterior, false);
            html += line('Caixa Líquido de Financiamento', fin.liquido.atual, fin.liquido.anterior, true);
            html += blank();

            // --- APURACAO ---
            html += header('APURAÇÃO DO FLUXO DE CAIXA DO PERÍODO', '#28a745');
            html += line('Geração Líquida de Caixa', cxa.geracao.atual, cxa.geracao.anterior, true);
            html += line('Caixa e Equivalentes Inicial', cxa.inicial.atual, cxa.inicial.anterior, false);
            html += line('Caixa e Equivalentes Final', cxa.final.atual, cxa.final.anterior, true);

            tb.innerHTML = html;
        }
        
        function blank() {
            return '<tr><td colspan="4" style="height:5px; border:none;"></td></tr>';
        }
        
        function carregar(){
const ano = document.getElementById('ano').value;
  const tipo = document.getElementById('tipo').value;
  const val = document.getElementById('val').value;
  const pA = mp(ano,tipo,val);
  const pB = mp(String(parseInt(ano)-1),tipo,val);
  fetch('/api/analise_dfc/'+pA)
    .then(r=>r.json())
    .then(a=>{
        // === CARD: demonstrativos faltando ===
        const conclEl = document.getElementById("concl");
        if (conclEl) { conclEl.style.display = "none"; conclEl.innerHTML = ""; }
        if (a && a.erro === "faltando") {
            const divErro = document.getElementById("concl") || document.querySelector(".concl") || document.body;
            divErro.style.display = "block";
            let htmlErro = '<div style="background:#fff3cd;border-left:5px solid #ffc107;padding:20px;border-radius:8px;">';
            htmlErro += '<h3 style="color:#856404;margin:0 0 10px 0;">⚠️ Demonstrativos Faltando</h3>';
            htmlErro += '<p style="color:#856404;">Os seguintes demonstrativos não foram importados:</p><ul style="color:#856404;">';
            [...new Set(a.pecas || [])].forEach(p => { htmlErro += '<li>' + p + '</li>'; });
            htmlErro += '</ul><p style="color:#856404;margin-top:10px;">Acesse <strong>Importar Relatórios</strong> para enviar os arquivos pendentes.</p></div>';
            divErro.innerHTML = htmlErro;
            const tbErro = document.querySelector("#tab tbody");
            if (tbErro) tbErro.innerHTML = '<tr><td colspan="4" style="text-align:center;color:#856404;">Aguardando importação.</td></tr>';
            if (typeof chart !== 'undefined' && chart) { chart.destroy(); chart = null; }
            return;
        }
      if(a.erro){alert(a.mensagem);return;}
      // Os dois periodos ja vem no mesmo JSON: a.dados
      document.getElementById('btn-confirmar').style.display = 'inline-block';
      document.getElementById('btn-confirmar').setAttribute('data-periodo-atual', pA);
      document.getElementById('btn-confirmar').setAttribute('data-periodo-anterior', pB);
      render(a.dados, a.dados);
    }).catch(e=>alert('Erro: '+e.message));
}
function salvar(){
  const btn = document.getElementById('btn-confirmar');
  const pA = btn.getAttribute('data-periodo-atual');
  const pB = btn.getAttribute('data-periodo-anterior');
  if(!pA){alert('Verifique primeiro.');return;}
  // Busca a API novamente para garantir que temos os dados atual + anterior corretos
  fetch('/api/analise_dfc/'+pA).then(r=>r.json()).then(a=>{
    if(a.erro){alert(a.mensagem);return;}
    // Envia para o backend: {atual: a.dados, anterior: a.dados} (mesmo CSV, duas colunas)
    const payload = {atual: a.dados, anterior: a.dados};
    // O backend espera /salvar_analise_dfc/{periodo_atual}/{periodo_anterior} via POST
    // Mas o formato de JSON nao e o que o backend usa. Vamos usar o formato simplificado:
    // Envia o JSON completo com atual e anterior (que sao o mesmo objeto, ja que o CSV tem as duas colunas)
    fetch('/salvar_analise_dfc/'+pA+'/'+pB, {method: 'POST'})
      .then(r=>{if(!r.ok)throw new Error('HTTP '+r.status);return r.json();})
      .then(()=>{alert('Relatorio salvo!');carregarHistorico();})
      .catch(e=>alert('Erro: '+e.message));
  });
}
function carregarHistorico(){
  const el = document.getElementById('historico-lista');
  fetch('/historico_analise_dfc').then(r=>r.json()).then(d=>{
    if(!d||d.length===0){el.innerHTML='<li>Nenhum histórico.</li>';return;}
    let html = '';
    d.forEach(i=>{html += '<li><label><input type="checkbox" class="check-hist" value="'+i.id+'"> <strong>'+i.periodo+'</strong><br><small>'+i.data_geracao+'</small></label></li>';});
    el.innerHTML = html;
  }).catch(()=>{el.innerHTML='<li>Erro.</li>';});
}
function excluirSelecionado(){
  const sel = document.querySelectorAll('.check-hist:checked');
  if(sel.length===0){alert('Selecione um item.');return;}
  if(!confirm('Excluir '+sel.length+'?'))return;
  Promise.all([...sel].map(c=>fetch('/excluir_analise_dfc/'+c.value,{method:'DELETE'}).then(r=>r.ok).catch(()=>false)))
    .then(rs=>{if(rs.some(x=>x)){alert('Excluído!');carregarHistorico();}});
}
function gerarPDF(){
  const ck = document.querySelector('.check-hist:checked');
  if(!ck){alert('Marque um item.');return;}
  window.open('/gerar_pdf_analise_dfc/'+ck.value,'_blank');
}
