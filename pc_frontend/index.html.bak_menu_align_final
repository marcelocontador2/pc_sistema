<script>
const API_URL="";
let currentTipo="BALANCETE";
const TITULOS={BALANCETE:"Balancete",BALANCO_PATRIMONIAL:"Balanço Patrimonial",BALANCO_ORCAMENTARIO:"Balanço Orçamentário",BALANCO_FINANCEIRO:"Balanço Financeiro",DFC:"DFC",DVP:"DVP",DMPL:"DMPL"};

function toggleSubmenu(el){
    document.getElementById('submenu-demonstracoes').classList.toggle('open');
}

function mostrarTela(tela, tipo=null) {
    document.querySelectorAll('.content-area').forEach(e=>e.classList.remove('active'));
    document.querySelectorAll('.nav-menu a,.submenu a').forEach(e=>e.classList.remove('active'));
    
    if(tela==='dashboard'){
        document.getElementById('tela-dashboard').classList.add('active');
        document.getElementById('menu-dashboard').classList.add('active');
    }
    else if(tela==='demonstracoes'){
        document.getElementById('tela-demonstracoes').classList.add('active');
        document.getElementById('menu-demonstracoes').classList.add('active');
        
        if(tipo){
            currentTipo = tipo;
            const submenuId = {
                'BALANCETE': 'submenu-balancete',
                'BALANCO_PATRIMONIAL': 'submenu-bp',
                'BALANCO_ORCAMENTARIO': 'submenu-bo',
                'BALANCO_FINANCEIRO': 'submenu-bf',
                'DFC': 'submenu-dfc',
                'DVP': 'submenu-dvp',
                'DMPL': 'submenu-dmpl'
            }[tipo];
            if(submenuId) document.getElementById(submenuId).classList.add('active');
            
            document.getElementById('titulo-demonstracao').innerText = TITULOS[tipo] || "Demonstrações";
            carregarPeriodos();
        }
        document.getElementById('submenu-demonstracoes').classList.add('open');
    }
    else if(tela==='upload'){
        document.getElementById('tela-upload').classList.add('active');
        document.getElementById('menu-upload').classList.add('active');
    }
}

function carregarPeriodos() {
    const select = document.getElementById('filtro-periodo');
    const reportsDiv = document.getElementById('reports-list');
    
    select.innerHTML = '<option value="">Carregando...</option>';
    if (reportsDiv) reportsDiv.innerHTML = '';
    
    fetch('/periodos_importados/' + currentTipo)
        .then(res => {
            if (!res.ok) throw new Error('Falha na resposta');
            return res.json();
        })
        .then(data => {
            select.innerHTML = '';
            if (!data || !data.periodos || data.periodos.length === 0) {
                select.innerHTML = '<option value="">Nenhum relatório importado</option>';
                if (reportsDiv) reportsDiv.innerHTML = '<p style="color: gray;">Nenhum relatório importado para este tipo.</p>';
                return;
            }
            data.periodos.forEach(p => {
                const partes = p.split('-');
                const ano = partes[0];
                const tipoP = partes[1];
                const valorP = partes[2];
                
                let textoFormatado = p;
                if (tipoP === 'MES') {
                    const meses = ["", "Janeiro", "Fevereiro", "Março", "Abril", "Maio", "Junho", "Julho", "Agosto", "Setembro", "Outubro", "Novembro", "Dezembro"];
                    textoFormatado = ano + " - " + meses[parseInt(valorP)];
                } else if (tipoP === 'TRIMESTRE') {
                    textoFormatado = ano + " - " + valorP + "º Trimestre";
                } else {
                    textoFormatado = ano + " - Exercício Completo";
                }

                const option = document.createElement('option');
                option.value = p; 
                option.textContent = textoFormatado;
                select.appendChild(option);
            });
            select.selectedIndex = 0;
            carregarListaRelatorios(currentTipo);
        })
        .catch(err => {
            console.error("Erro ao buscar periodos:", err);
            select.innerHTML = '<option value="">Erro ao buscar</option>';
            if (reportsDiv) reportsDiv.innerHTML = '<p style="color: red;">Falha ao buscar períodos.</p>';
        });
}

function carregarListaRelatorios(tipo) {
    const reportsDiv = document.getElementById('reports-list');
    const selectPeriodo = document.getElementById('filtro-periodo');
    const periodoSelecionado = selectPeriodo.value;
    
    if (!periodoSelecionado) {
        reportsDiv.innerHTML = '';
        return;
    }
    
    reportsDiv.innerHTML = `
        <a href="/download/pdf/` + tipo + `?ano=` + periodoSelecionado.split('-')[0] + `&periodo=` + periodoSelecionado + `" target="_blank" style="text-decoration: none; color: inherit; display: block;">
            <div style="background: #fff; padding: 20px; border-radius: 8px; box-shadow: 0 2px 5px rgba(0,0,0,0.1); display: flex; justify-content: space-between; align-items: center; cursor: pointer; transition: all 0.2s;" onmouseover="this.style.transform='scale(1.02)'; this.style.boxShadow='0 4px 10px rgba(0,0,0,0.15)';" onmouseout="this.style.transform='scale(1)'; this.style.boxShadow='0 2px 5px rgba(0,0,0,0.1)';">
                <div>
                    <h3 style="margin: 0; color: #0d6efd;">` + TITULOS[tipo] + `</h3>
                    <p style="margin: 5px 0 0 0; color: #666; font-size: 14px;">Período: ` + selectPeriodo.options[selectPeriodo.selectedIndex].text + `</p>
                    <p style="margin: 5px 0 0 0; color: #999; font-size: 12px;">Clique para baixar o PDF</p>
                </div>
                <div style="font-size: 32px; color: #0d6efd;">📄</div>
            </div>
        </a>
    `;
    
    atualizarBotoesDownload();
}

function atualizarBotoesDownload() {
    const periodo = document.getElementById('filtro-periodo').value;
    if (!periodo) return;
    
    const ano = periodo.split('-')[0];
    
    // Garante que os links dos botões do topo apontem para o período selecionado
    document.getElementById('btn-pdf').href = '/download/pdf/' + currentTipo + '?ano=' + ano + '&periodo=' + encodeURIComponent(periodo);
    document.getElementById('btn-excel').href = '/download/excel/' + currentTipo + '?ano=' + ano + '&periodo=' + encodeURIComponent(periodo);
    document.getElementById('btn-pptx').href = '/download/pptx/' + currentTipo + '?ano=' + ano + '&periodo=' + encodeURIComponent(periodo);
}

async function enviarArquivo(event) {
    event.preventDefault();
    
    const tipo = document.getElementById('upload-tipo').value;
    const ano = document.getElementById('upload-ano').value;
    const mes = document.getElementById('upload-mes').value;
    const trimestre = document.getElementById('upload-trimestre').value;
    const exercicio = document.getElementById('upload-exercicio').value;
    const arquivo = document.getElementById('upload-arquivo').files[0];
    const msgDiv = document.getElementById('upload-mensagem');

    if (!tipo) { msgDiv.innerHTML = "<span style='color: red;'>Selecione o Tipo de Relatório.</span>"; return; }

    let periodo_tipo = "", periodo_valor = "";
    if (mes) { periodo_tipo = "MES"; periodo_valor = mes; }
    else if (trimestre) { periodo_tipo = "TRIMESTRE"; periodo_valor = trimestre; }
    else if (exercicio) { periodo_tipo = "ANO"; periodo_valor = ano; }
    else { msgDiv.innerHTML = "<span style='color: red;'>Selecione um dos períodos.</span>"; return; }
    
    if (!arquivo) { msgDiv.innerHTML = "<span style='color: red;'>Anexe um arquivo CSV.</span>"; return; }

    const formData = new FormData();
    formData.append("file", arquivo);
    formData.append("tipo_relatorio", tipo);
    formData.append("ano", ano);
    formData.append("periodo_tipo", periodo_tipo);
    formData.append("periodo_valor", periodo_valor);

    msgDiv.innerHTML = "<span style='color: blue;'>Enviando arquivo... Aguarde.</span>";
    
    try {
        const response = await fetch('/upload', { 
            method: 'POST', 
            body: formData 
        });
        
        // Tenta ler a resposta do servidor (mesmo se der erro)
        let result;
        try {
            result = await response.json();
        } catch (e) {
            throw new Error("O servidor nao retornou um JSON valido.");
        }

        if (response.ok) {
            msgDiv.innerHTML = "<span style='color: green;'>Sucesso! " + (result.mensagem || "Arquivo enviado.") + " (" + (result.arquivo || "") + ")</span>";
            document.getElementById('form-upload').reset();
            document.getElementById('upload-ano').value = "2026";
            desativarOutrosPeriodos('');
        } else {
            msgDiv.innerHTML = "<span style='color: red;'>Erro no servidor: " + (result.detail || "Falha desconhecida") + "</span>";
        }
    } catch (error) {
        console.error("Erro no upload:", error);
        msgDiv.innerHTML = "<span style='color: red;'>Erro de conexão: " + error.message + ". Verifique se o servidor esta rodando.</span>";
    }
}function desativarOutrosPeriodos(origem) {
    const selectMes = document.getElementById('upload-mes');
    const selectTrimestre = document.getElementById('upload-trimestre');
    const selectExercicio = document.getElementById('upload-exercicio');
    if (origem === 'mes' && selectMes.value !== '') { selectTrimestre.disabled = true; selectTrimestre.value = ''; selectExercicio.disabled = true; selectExercicio.value = ''; }
    else if (origem === 'trimestre' && selectTrimestre.value !== '') { selectMes.disabled = true; selectMes.value = ''; selectExercicio.disabled = true; selectExercicio.value = ''; }
    else if (origem === 'exercicio' && selectExercicio.value !== '') { selectMes.disabled = true; selectMes.value = ''; selectTrimestre.disabled = true; selectTrimestre.value = ''; }
    else { selectMes.disabled = false; selectTrimestre.disabled = false; selectExercicio.disabled = false; }
}

document.getElementById('filtro-periodo').addEventListener('change', () => { carregarListaRelatorios(currentTipo); });
</script>

