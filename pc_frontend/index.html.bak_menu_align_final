<style>
:root{--cofen-blue:#0072BA;--cofen-gray:#878787;--cofen-dark:#1D1D1D;--cofen-white:#FFF;--cofen-light-gray:#F5F5F5;--cofen-border:#E0E0E0}
*{margin:0;padding:0;box-sizing:border-box;font-family:'Inter',sans-serif}
body{background:var(--cofen-light-gray);color:var(--cofen-dark);display:flex;height:100vh}
.sidebar{width:280px;background:var(--cofen-white);border-right:1px solid var(--cofen-border);display:flex;flex-direction:column;padding:20px 0;overflow-y:auto}
.logo-area{padding:0 20px 20px;border-bottom:1px solid var(--cofen-border);margin-bottom:20px}
.logo-area h1{color:var(--cofen-blue);font-size:24px}
.logo-area p{color:var(--cofen-gray);font-size:12px;margin-top:5px}
.nav-menu{list-style:none;padding:0 10px}
.nav-menu a{display:flex;align-items:center;padding:12px 15px;text-decoration:none;color:var(--cofen-dark);font-weight:500;font-size:14px;border-radius:8px;cursor:pointer}
.nav-menu a:hover,.nav-menu a.active{background:var(--cofen-blue);color:#fff}
.submenu{list-style:none;padding-left:35px;display:none}
.submenu.open{display:block}
