<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>PC - Prestacao de Contas | COFEN</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
<style>
:root{--cofen-blue:#0072BA;--cofen-gray:#878787;--cofen-dark:#1D1D1D;--cofen-white:#FFF;--cofen-light-gray:#F5F5F5;--cofen-border:#E0E0E0}
*{margin:0;padding:0;box-sizing:border-box;font-family:'Inter',sans-serif}
body{background:var(--cofen-light-gray);color:var(--cofen-dark);display:flex;height:100vh}
.sidebar{width:280px;background:var(--cofen-white);border-right:1px solid var(--cofen-border);display:flex;flex-direction:column;padding:20px 0;overflow-y:auto}
.logo-area{padding:0 20px 20px;border-bottom:1px solid var(--cofen-border);margin-bottom:20px}
.logo-area h1{color:var(--cofen-blue);font-size:24px}
.logo-area p{color:var(--cofen-gray);font-size:12px;margin-top:5px}
.nav-menu{list-style:none;padding:0 10px}
.nav-menu a{display:flex;align-items:center;padding:12px 15px;text-decoration:none;color:var(--cofen-dark);font-weight:500;font-size:14px;border-radius:8px;cursor:pointer}
.nav-menu a:hover,.nav-menu a.active{background:var(--cofen-blue);color:#fff}
.submenu{list-style:none;padding-left:35px;display:none}
.submenu.open{display:block}
.submenu li a{padding:8px 15px;font-size:13px;color:var(--cofen-gray)}
.submenu li a.active{color:var(--cofen-blue);font-weight:700;background:transparent}
.main-content{flex:1;display:flex;flex-direction:column;overflow-y:auto}
.header{background:var(--cofen-white);padding:15px 30px;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid var(--cofen-border)}
.user-avatar{width:32px;height:32px;background:var(--cofen-blue);color:#fff;border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:600}
.content-area{padding:30px;display:none}
.content-area.active{display:block}
.page-title{font-size:24px;font-weight:700;margin-bottom:20px}
.top-bar{display:flex;justify-content:space-between;align-items:center;background:#fff;padding:15px 20px;border-radius:8px;border:1px solid var(--cofen-border);margin-bottom:30px;flex-wrap:wrap;gap:15px}
.filter-group{display:flex;align-items:center;gap:10px}
.filter-group select{padding:10px 15px;border:1px solid var(--cofen-border);border-radius:6px;min-width:200px;font-size:14px;outline:none}
.filter-group select:focus{border-color:var(--cofen-blue)}
.action-group{display:flex;gap:10px;opacity:0;pointer-events:none;transition:opacity .3s}
.action-group.active{opacity:1;pointer-events:auto}
.btn-action{padding:10px 16px;font-size:13px;font-weight:600;border-radius:6px;cursor:pointer;border:1px solid transparent;text-decoration:none;display:inline-flex;align-items:center;gap:6px;transition:background .2s}
.btn-pdf{color:#c62828;border-color:#ffcdd2;background:#ffebee}
.btn-pdf:hover{background:#ffcdd2}
.btn-excel{color:#2e7d32;border-color:#c8e6c9;background:#e8f5e9}
.btn-excel:hover{background:#c8e6c9}
.btn-pptx{color:#ef6c00;border-color:#ffe0b2;background:#fff3e0}
.btn-pptx:hover{background:#ffe0b2}
.reports-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(400px,1fr));gap:20px}
.report-card{background:#fff;border-radius:12px;border:1px solid var(--cofen-border);box-shadow:0 4px 10px rgba(0,0,0,0.05);display:flex;align-items:center;padding:25px;text-decoration:none;color:inherit;transition:transform .2s,box-shadow .2s;cursor:pointer}
.report-card:hover{transform:translateY(-3px);box-shadow:0 8px 20px rgba(0,0,0,0.1);border-color:var(--cofen-blue)}
.report-icon{width:56px;height:56px;background:#e3f2fd;color:var(--cofen-blue);border-radius:12px;display:flex;align-items:center;justify-content:center;margin-right:20px;flex-shrink:0}
.report-icon svg{width:32px;height:32px}
.report-info h3{font-size:20px;color:var(--cofen-blue);margin-bottom:6px}
.report-info p{font-size:14px;color:var(--cofen-gray)}
.report-info span{font-size:13px;color:var(--cofen-blue);font-weight:600;margin-top:8px;display:block}
.cards-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:15px;margin-bottom:20px}
.card{background:#fff;padding:20px;border-radius:12px;border:1px solid var(--cofen-border)}
.card-label{display:block;font-size:12px;color:var(--cofen-gray);margin-bottom:5px}
.card-value{font-size:20px;font-weight:700;color:var(--cofen-blue)}
.empty-state{text-align:center;padding:40px;color:var(--cofen-gray);background:#fff;border-radius:12px;border:1px dashed var(--cofen-border)}
.upload-box{display:none}
</style>
        <style>
