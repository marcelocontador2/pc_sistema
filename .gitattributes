# Normaliza EOL no repo
* text=auto eol=lf

# Binarios
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary

# Scripts Windows
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Python
*.py text eol=lf

# Config
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
