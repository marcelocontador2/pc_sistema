<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Custo de Pessoal x Limite da LRF (Art. 19)</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        body { background-color: #f8f9fa; color: #333; display: flex; height: 100vh; overflow: hidden; }
        
        .sidebar { width: 260px; background: #fff; border-right: 1px solid #e0e0e0; display: flex; flex-direction: column; flex-shrink: 0; overflow-y: auto; }
        .sidebar-header { padding: 20px; border-bottom: 1px solid #e0e0e0; }
        .sidebar-header h1 { color: #0072BA; font-size: 24px; font-weight: 800; }
        .sidebar-header span { color: #888; font-size: 12px; font-weight: normal; display: block; margin-top: 4px; }
        
        .main { flex: 1; display: flex; flex-direction: column; overflow: hidden; width: calc(100vw - 260px); }
        .topbar { height: 70px; background: #fff; border-bottom: 1px solid #e0e0e0; display: flex; justify-content: space-between; align-items: center; padding: 0 30px; }
        .topbar h2 { font-size: 20px; color: #333; }
        
        .content { flex: 1; padding: 30px; overflow-y: auto; }
        .card { background: #fff; border-radius: 8px; box-shadow: 0 4px 15px rgba(0,0,0,0.05); border-top: 6px solid #0072BA; padding: 30px; width: 100%; max-width: 1200px; margin: 0 auto; }
        
        .btn { padding: 10px 20px; border: none; border-radius: 4px; cursor: pointer; color: white; font-weight: bold; margin-right: 10px; font-size: 14px; }
        .btn-voltar { background: #ff8c00; }
        .btn-exibir { background: #28a745; }
        .btn-excluir { background: #dc3545; }
        .btn-pdf { background: #003366; }
        .btn-verificar { background: #003366; }
        .btn-salvar { background: #28a745; }
        
        .top-bar { margin-bottom: 20px; display: flex; gap: 10px; flex-wrap: wrap; align-items: center; }
        .top-bar select { padding: 8px; border: 1px solid #ccc; border-radius: 4px; }
        
        table { width: 100%; border-collapse: collapse; margin-top: 15px; }
        th { background: #eef4fa; color: #333; padding: 12px; text-align: left; font-size: 14px; font-weight: bold; }
        td { padding: 12px; border-bottom: 1px solid #eee; font-size: 14px; }
        .total-row td { font-weight: bold; background: #eef4fa; }
        .situacao-verde { color: #28a745; font-weight: bold; }
        .situacao-vermelho { color: #dc3545; font-weight: bold; }
        
        .historico-item { display: block; padding: 8px 10px; border-bottom: 1px solid #eee; cursor: pointer; font-size: 13px; }
    </style>
</head>
<body>
    <div class="sidebar">
        <div class="sidebar-header">
            <h1>Histórico Salvo</h1>
            <span>Consulte relatórios anteriores</span>
        </div>
        <div class="sidebar-menu" id="lista-historico">
            <div style="padding: 15px; color: #888; font-size: 13px;">Carregando...</div>
        </div>
    </div>
    
    <div class="main">
        <div class="topbar">
            <h2>Custo de Pessoal</h2>
            <div style="font-size: 13px; color: #888;">SIGPC - Sistema de Gestão</div>
        </div>
        
        <div class="content">
            <div class="card">
                <div class="top-bar">
                    <button class="btn btn-voltar" onclick="window.location.href='/'">← Voltar</button>
                    <span style="font-weight: bold;">Período:</span>
                    <select id="periodo-select">
                        <option value="2026-TRIMESTRE-3">2026 - 3º Trimestre</option>
                    </select>
                    <button class="btn btn-verificar" onclick="carregar()">Verificar Análise</button>
                    <button class="btn btn-salvar" id="btn-salvar" onclick="salvar()">Confirmar e Salvar</button>
                    <button class="btn btn-exibir" onclick="exibirSelecionado()">Exibir Selecionado</button>
                    <button class="btn btn-excluir" onclick="excluirSelecionado()">Excluir Selecionado</button>
                    <button class="btn btn-pdf" onclick="gerarPDF()">Gerar PDF</button>
                </div>
                
                <div class="hdr-sub">Custo de Pessoal x Limite da LRF (Art. 19)</div>
                <h1 style="font-size: 28px; color: #0a1c3a; margin-bottom: 20px;">Apuração consolidada 12 meses</h1>
                
                <table>
                    <thead>
                        <tr>
                            <th>Indicador</th>
                            <th>Valor (R$)</th>
                            <th>% da RCL</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>Receita Corrente Líquida (RCL)</td>
                            <td id="comp-rcl">0,00</td>
                            <td>100,00%</td>
                        </tr>
                        <tr>
                            <td>(-) Custo de Pessoal (Bruto)</td>
                            <td id="comp-custo">0,00</td>
                            <td id="comp-pct">0,00%</td>
                        </tr>
                        <tr class="total-row">
                            <td>(=) Margem Disponível (Limite LRF - Custo)</td>
                            <td id="comp-margem">0,00</td>
                            <td id="comp-pct-margem">0,00%</td>
                        </tr>
                        <tr>
                            <td>Limite LRF (50% da RCL)</td>
                            <td id="comp-limite">0,00</td>
                            <td>50,00%</td>
                        </tr>
                        <tr>
                            <td>Situação</td>
                            <td></td>
                            <td id="comp-situacao">-</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    


















<script>
    alert('O JavaScript do Custo foi carregado com sucesso!');

    function fmt(v) {
        return Number(v).toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }

    function carregar() {
        const select = document.getElementById('periodo-select');
        const periodo = select ? select.value : '2026-TRIMESTRE-3';
        console.log('Buscando dados para:', periodo);
        
        fetch('/api/custo_pessoal/' + periodo)
            .then(r => {
                if (!r.ok) throw new Error('Erro HTTP: ' + r.status);
                return r.json();
            })
            .then(d => {
                console.log('Dados recebidos:', d);
                if (d.erro) { alert('API erro: ' + d.erro); return; }
                
                document.getElementById('comp-rcl').innerText = fmt(d.rcl_total || 0);
                document.getElementById('comp-custo').innerText = fmt(d.custo_total || 0);
                document.getElementById('comp-limite').innerText = fmt(d.limite || (d.rcl_total * 0.5));
                document.getElementById('comp-margem').innerText = fmt(d.margem || ((d.rcl_total * 0.5) - d.custo_total));
                document.getElementById('comp-pct').innerText = ((d.custo_total / d.rcl_total) * 100).toFixed(2) + '%';
            })
            .catch(e => {
                console.error('Erro no fetch:', e);
                alert('Erro ao buscar dados. Veja o Console.');
            });
    }

    function salvar() {
        const select = document.getElementById('periodo-select');
        const periodo = select ? select.value : '2026-TRIMESTRE-3';
        const btn = document.getElementById('btn-salvar');
        if (btn) { btn.innerText = 'Salvando...'; btn.disabled = true; }
        
        fetch('/salvar_custo_pessoal/' + periodo, { method: 'POST' })
            .then(r => r.json())
            .then(d => {
                if (d.erro) alert('Erro ao salvar: ' + d.mensagem);
                else alert('Relatório salvo com sucesso!');
            })
            .catch(e => alert('Erro ao salvar: ' + e.message))
            .finally(() => { if (btn) { btn.innerText = 'Confirmar e Salvar'; btn.disabled = false; } });
    }

    function carregarHistorico() {
        fetch('/historico_custo_pessoal')
            .then(r => r.json())
            .then(d => {
                const lista = document.getElementById('lista-historico');
                if (!lista) return;
                lista.innerHTML = '';
                if (Array.isArray(d)) {
                    d.forEach(item => {
                        const div = document.createElement('div');
                        div.innerHTML = <input type="radio" name="hist" value=""> ;
                        lista.appendChild(div);
                    });
                }
            })
            .catch(e => console.error('Erro histórico:', e));
    }

    window.onload = function() {
        console.log('Página carregada, iniciando...');
        carregar();
        carregarHistorico();
    };
</script>

</body>
</html>