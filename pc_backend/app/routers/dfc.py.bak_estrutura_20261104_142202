"""
Rota da Demonstração do Fluxo de Caixa (DFC) — baseada no modelo do BF.
"""
import csv
import os
from fastapi import APIRouter, HTTPException

router = APIRouter(prefix="/api/analise_dfc", tags=["dfc"])

BASE_DIR = os.path.dirname(os.path.abspath(__file__))
UPLOADS_DIR = os.path.join(BASE_DIR, "..", "..", "..", "pc_storage", "uploads_raw")

def limpar(v):
    if not v:
        return 0.0
    v = str(v).replace("R$", "").strip()
    if v in ["-", "0,00", ""]:
        return 0.0
    if "," in v and "." in v:
        v = v.replace(".", "").replace(",", ".")
    elif "," in v:
        v = v.replace(",", ".")
    try:
        return float(v)
    except Exception:
        return 0.0

def processar_dfc(caminho):
    linhas = []
    with open(caminho, "r", encoding="latin-1", errors="ignore") as f:
        leitor = csv.reader(f, delimiter=";")
        for row in leitor:
            linhas.append(row)

    def buscar(termo):
        termo = termo.upper().strip()
        for p in linhas:
            if len(p) > 0 and termo in str(p[0]).upper():
                return p
            if len(p) > 3 and termo in str(p[3]).upper():
                return p
        return None

    def val(p, idx):
        if p and len(p) > idx:
            return abs(limpar(p[idx]))
        return 0.0

    # --- BUSCAS ESPECÍFICAS DA DFC ---
    # Operacional
    l_rec_oper = buscar("RECEBIMENTOS OPERACIONAIS")
    l_pag_oper = buscar("PAGAMENTOS OPERACIONAIS")
    # Detalhes Operacionais
    l_rec_contrib = buscar("CONTRIBUIÇÕES")
    l_rec_taxas = buscar("TAXAS")
    l_rec_servicos = buscar("SERVIÇOS")
    l_pag_pessoal = buscar("PESSOAL")
    l_pag_custeio = buscar("CUSTEIO")
    # Investimento
    l_rec_invest = buscar("RECEBIMENTOS DE INVESTIMENTOS")
    l_pag_invest = buscar("PAGAMENTOS DE INVESTIMENTOS")
    l_venda_ativos = buscar("VENDA DE ATIVOS")
    l_aquisicao_ativos = buscar("AQUISIÇÃO DE ATIVOS")
    # Financiamento
    l_rec_financ = buscar("RECEBIMENTOS DE FINANCIAMENTOS")
    l_pag_financ = buscar("PAGAMENTOS DE FINANCIAMENTOS")
    l_emprestimos = buscar("EMPRÉSTIMOS OBTIDOS")
    l_amortizacoes = buscar("AMORTIZAÇÕES")
    # Caixa
    l_saldo_inicial = buscar("SALDO INICIAL")
    l_saldo_final = buscar("SALDO FINAL")
    # Extra
    l_rec_extra = buscar("RECEBIMENTOS EXTRAORÇAMENTÁRIOS")
    l_pag_extra = buscar("PAGAMENTOS EXTRAORÇAMENTÁRIOS")

    dados = {
        "operacional": {
            "recebimentos": {"atual": val(l_rec_oper, 1), "anterior": val(l_rec_oper, 2)},
            "pagamentos": {"atual": val(l_pag_oper, 4), "anterior": val(l_pag_oper, 5)},
            "detalhes": {
                "contribuicoes": {"atual": val(l_rec_contrib, 1), "anterior": val(l_rec_contrib, 2)},
                "taxas": {"atual": val(l_rec_taxas, 1), "anterior": val(l_rec_taxas, 2)},
                "servicos": {"atual": val(l_rec_servicos, 1), "anterior": val(l_rec_servicos, 2)},
                "pessoal": {"atual": val(l_pag_pessoal, 4), "anterior": val(l_pag_pessoal, 5)},
                "custeio": {"atual": val(l_pag_custeio, 4), "anterior": val(l_pag_custeio, 5)},
            }
        },
        "investimento": {
            "recebimentos": {"atual": val(l_rec_invest, 1), "anterior": val(l_rec_invest, 2)},
            "pagamentos": {"atual": val(l_pag_invest, 4), "anterior": val(l_pag_invest, 5)},
            "detalhes": {
                "venda_ativos": {"atual": val(l_venda_ativos, 1), "anterior": val(l_venda_ativos, 2)},
                "aquisicao_ativos": {"atual": val(l_aquisicao_ativos, 4), "anterior": val(l_aquisicao_ativos, 5)},
            }
        },
        "financiamento": {
            "recebimentos": {"atual": val(l_rec_financ, 1), "anterior": val(l_rec_financ, 2)},
            "pagamentos": {"atual": val(l_pag_financ, 4), "anterior": val(l_pag_financ, 5)},
            "detalhes": {
                "emprestimos": {"atual": val(l_emprestimos, 1), "anterior": val(l_emprestimos, 2)},
                "amortizacoes": {"atual": val(l_amortizacoes, 4), "anterior": val(l_amortizacoes, 5)},
            }
        },
        "extra": {
            "recebimentos": {"atual": val(l_rec_extra, 1), "anterior": val(l_rec_extra, 2)},
            "pagamentos": {"atual": val(l_pag_extra, 4), "anterior": val(l_pag_extra, 5)},
        },
        "caixa": {
            "saldo_inicial": {"atual": val(l_saldo_inicial, 1), "anterior": val(l_saldo_inicial, 2)},
            "saldo_final": {"atual": val(l_saldo_final, 4), "anterior": val(l_saldo_final, 5)},
        }
    }

    # Totais
    dados["operacional"]["total"] = {
        "atual": dados["operacional"]["recebimentos"]["atual"] - dados["operacional"]["pagamentos"]["atual"],
        "anterior": dados["operacional"]["recebimentos"]["anterior"] - dados["operacional"]["pagamentos"]["anterior"]
    }
    dados["investimento"]["total"] = {
        "atual": dados["investimento"]["recebimentos"]["atual"] - dados["investimento"]["pagamentos"]["atual"],
        "anterior": dados["investimento"]["recebimentos"]["anterior"] - dados["investimento"]["pagamentos"]["anterior"]
    }
    dados["financiamento"]["total"] = {
        "atual": dados["financiamento"]["recebimentos"]["atual"] - dados["financiamento"]["pagamentos"]["atual"],
        "anterior": dados["financiamento"]["recebimentos"]["anterior"] - dados["financiamento"]["pagamentos"]["anterior"]
    }
    dados["extra"]["total"] = {
        "atual": dados["extra"]["recebimentos"]["atual"] - dados["extra"]["pagamentos"]["atual"],
        "anterior": dados["extra"]["recebimentos"]["anterior"] - dados["extra"]["pagamentos"]["anterior"]
    }

    # Geração Líquida
    dados["caixa"]["geracao_liquida"] = {
        "atual": dados["operacional"]["total"]["atual"] + dados["investimento"]["total"]["atual"] + dados["financiamento"]["total"]["atual"] + dados["extra"]["total"]["atual"],
        "anterior": dados["operacional"]["total"]["anterior"] + dados["investimento"]["total"]["anterior"] + dados["financiamento"]["total"]["anterior"] + dados["extra"]["total"]["anterior"]
    }

    return {"erro": False, "dados": dados}

@router.get("/{periodo}")
async def api_analise_dfc(periodo: str):
    p_limpo = periodo.replace("-", "_")
    caminho = os.path.join(UPLOADS_DIR, f"DFC_{p_limpo}.csv")
    if not os.path.exists(caminho):
        return {"erro": "faltando", "pecas": ["DFC"]}
    try:
        return processar_dfc(caminho)
    except Exception as e:
        print(f"[DFC] ERRO: {e}")
        raise HTTPException(status_code=500, detail=str(e))
