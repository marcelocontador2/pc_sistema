import json
from datetime import datetime
from fastapi import Response
import psycopg2
from pc_backend.app.config import PG_CONFIG


@router.post("/salvar/{periodo}/{periodo_anterior}")
def salvar_analise_dvp(periodo: str, periodo_anterior: str):
    try:
        p_limpo = periodo.replace("-", "_")
        caminho = os.path.join(UPLOADS_DIR, f"DVP_{p_limpo}.csv")
        if not os.path.exists(caminho):
            return {"ok": False, "mensagem": f"CSV nao encontrado: DVP_{p_limpo}.csv"}
        
        resultado = processar_dvp(caminho)
        if resultado.get("erro"):
            return {"ok": False, "mensagem": resultado.get("mensagem", "Erro no processamento")}
        
        dados_json = resultado["dados"]
        periodo_label = f"{periodo} vs {periodo_anterior}"
        
        conn = psycopg2.connect(**PG_CONFIG)
        cur = conn.cursor()
        cur.execute("""
            INSERT INTO historico_analise_dvp (periodo, data_geracao, resultado_json)
            VALUES (%s, NOW(), %s) RETURNING id
        """, (periodo_label, json.dumps(dados_json, ensure_ascii=False)))
        new_id = cur.fetchone()[0]
        conn.commit()
        conn.close()
        
        return {"ok": True, "id": new_id, "mensagem": "Salvo com sucesso"}
    except Exception as e:
        import traceback
        print(f"[DVP] Erro ao salvar: {e}\n{traceback.format_exc()}")
        return {"ok": False, "mensagem": str(e)}


@router.get("/historico")
def get_historico_dvp():
    try:
        conn = psycopg2.connect(**PG_CONFIG)
        cur = conn.cursor()
        cur.execute("SELECT id, periodo, data_geracao FROM historico_analise_dvp ORDER BY id DESC")
        rows = cur.fetchall()
        conn.close()
        return [{"id": r[0], "periodo": r[1], "data_geracao": str(r[2])} for r in rows]
    except Exception as e:
        print(f"[DVP] Erro ao listar historico: {e}")
        return []


@router.get("/historico/{id}")
def get_historico_dvp_id(id: int):
    try:
        conn = psycopg2.connect(**PG_CONFIG)
        cur = conn.cursor()
        cur.execute("SELECT periodo, resultado_json FROM historico_analise_dvp WHERE id = %s", (id,))
        row = cur.fetchone()
        conn.close()
        if not row:
            return {"erro": True, "mensagem": "Nao encontrado"}
        dados = row[1] if isinstance(row[1], dict) else json.loads(row[1])
        return {"erro": False, "periodo": row[0], "dados": dados}
    except Exception as e:
        return {"erro": True, "mensagem": str(e)}


@router.delete("/excluir/{id}")
def excluir_dvp(id: int):
    try:
        conn = psycopg2.connect(**PG_CONFIG)
        cur = conn.cursor()
        cur.execute("DELETE FROM historico_analise_dvp WHERE id = %s", (id,))
        conn.commit()
        conn.close()
        return {"ok": True}
    except Exception as e:
        return {"ok": False, "mensagem": str(e)}


@router.get("/gerar_pdf_novo/{id}")
def gerar_pdf_analise_dvp(id: int):
    """Gera PDF do DVP com acentos corretos (usa novo_pdf)."""
    import json
    import traceback
    import psycopg2
    from fastapi import Response
    from pc_backend.app.config import PG_CONFIG
    from pc_backend.core.pdf_utils import novo_pdf, fmt_brl, NOVA_LINHA

    try:
        conn = psycopg2.connect(**PG_CONFIG)
        cur = conn.cursor()
        cur.execute(
            "SELECT periodo, resultado_json FROM historico_analise_dvp WHERE id = %s",
            (id,),
        )
        row = cur.fetchone()
        conn.close()
        if not row:
            return Response(content="Registro nao encontrado",
                            media_type="text/plain", status_code=404)

        periodo_label = row[0]
        dados = row[1] if isinstance(row[1], dict) else json.loads(row[1])

        pdf = novo_pdf(orientation="P", unit="mm", format="A4")
        pdf.set_auto_page_break(auto=True, margin=15)
        pdf.add_page()
        W = pdf.w

        # Cabecalho
        pdf.set_fill_color(0, 51, 102)
        pdf.rect(0, 0, W, 30, style="F")
        pdf.set_text_color(255, 255, 255)
        pdf.set_font("Arial", "B", 16)
        pdf.set_xy(15, 8)
        pdf.cell(0, 8, "DVP - Demonstração das Variações Patrimoniais")
        pdf.set_font("Arial", "", 10)
        pdf.set_xy(15, 18)
        pdf.cell(0, 6, f"Período: {periodo_label}")

        # Valores
        vpa = (dados.get("total_vpa") or {}).get("atual", 0)
        vpd = (dados.get("total_vpd") or {}).get("atual", 0)
        res = (dados.get("resultado") or {}).get("atual", 0)

        # Caixa VPA
        pdf.set_fill_color(227, 242, 253)
        pdf.rect(15, 40, 85, 15, style="F")
        pdf.set_text_color(0, 51, 102)
        pdf.set_font("Arial", "B", 12)
        pdf.set_xy(20, 43)
        pdf.cell(0, 6, fmt_brl(vpa))
        pdf.set_font("Arial", "", 9)
        pdf.set_text_color(102, 102, 102)
        pdf.set_xy(20, 50)
        pdf.cell(0, 4, "Total VPA (Variações Aumentativas)")

        # Caixa VPD
        pdf.set_fill_color(255, 235, 238)
        pdf.rect(110, 40, 85, 15, style="F")
        pdf.set_text_color(220, 53, 69)
        pdf.set_font("Arial", "B", 12)
        pdf.set_xy(115, 43)
        pdf.cell(0, 6, fmt_brl(vpd))
        pdf.set_font("Arial", "", 9)
        pdf.set_text_color(102, 102, 102)
        pdf.set_xy(115, 50)
        pdf.cell(0, 4, "Total VPD (Variações Diminutivas)")

        # Caixa Superavit
        pdf.set_fill_color(232, 245, 233)
        pdf.rect(15, 62, 180, 18, style="F")
        pdf.set_text_color(0, 51, 102)
        pdf.set_font("Arial", "B", 14)
        pdf.set_xy(20, 66)
        pdf.cell(0, 7, fmt_brl(res))
        pdf.set_font("Arial", "B", 10)
        pdf.set_xy(20, 73)
        pdf.cell(0, 5, "Superávit Patrimonial")

        # Tabela
        y = 90
        pdf.set_fill_color(0, 51, 102)
        pdf.rect(15, y, 180, 8, style="F")
        pdf.set_text_color(255, 255, 255)
        pdf.set_font("Arial", "B", 9)
        pdf.set_xy(20, y + 2)
        pdf.cell(70, 4, "Indicador")
        pdf.set_xy(100, y + 2)
        pdf.cell(40, 4, "Período Atual")
        pdf.set_xy(150, y + 2)
        pdf.cell(40, 4, "Período Anterior")
        y += 8

        pdf.set_text_color(0, 0, 0)
        pdf.set_font("Arial", "", 9)
        itens = [
            ("vpa_financeiras",  "VPA Financeiras"),
            ("transf_recebidas", "Transferências Recebidas"),
            ("outras_vpa",       "Outras VPA"),
            ("total_vpa",        "TOTAL VPA"),
            ("vpd_financeiras",  "VPD Financeiras"),
            ("pessoal_encargos", "Pessoal e Encargos"),
            ("servicos",         "Serviços"),
            ("total_vpd",        "TOTAL VPD"),
        ]
        for chave, nome in itens:
            bloco = dados.get(chave) or {}
            val = bloco.get("atual", 0)
            ant = bloco.get("anterior", 0)
            pdf.set_xy(20, y + 2)
            pdf.cell(70, 4, nome)
            pdf.set_xy(100, y + 2)
            pdf.cell(40, 4, fmt_brl(val))
            pdf.set_xy(150, y + 2)
            pdf.cell(40, 4, fmt_brl(ant))
            y += 7

        pdf_bytes = bytes(pdf.output())
        return Response(
            content=pdf_bytes,
            media_type="application/pdf",
            headers={"Content-Disposition": f"inline; filename=DVP_{id}.pdf"},
        )
    except Exception as e:
        print("[DVP] PDF erro:", e)
        print(traceback.format_exc())
        return Response(content=f"ERRO: {e}", media_type="text/plain", status_code=500)




