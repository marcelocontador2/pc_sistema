"""
Router DVP - Demonstracao das Variacoes Patrimoniais.
Substitui pc_backend/app/routers/dvp.py (mantido como backup).
Rotas identicas as do frontend:
  GET  /{periodo}
  POST /salvar/{periodo}/{periodo_anterior}
  GET  /historico
  GET  /historico/{id}
  DEL  /excluir/{id}
  GET  /gerar_pdf_novo/{id}
"""
import json
import traceback
from fastapi import APIRouter, Response
import psycopg2

from pc_backend.core.pdf_utils import novo_pdf, fmt_brl, NOVA_LINHA
from pc_backend.app.config import PG_CONFIG

router = APIRouter()


def _conn():
    return psycopg2.connect(**PG_CONFIG)


# ---------------------------------------------------------------------------
# GET /{periodo}
# ---------------------------------------------------------------------------
@router.get("/{periodo}")
def get_analise_dvp(periodo: str):
    try:
        conn = _conn()
        cur = conn.cursor()
        cur.execute(
            "SELECT resultado_json FROM historico_analise_dvp "
            "WHERE periodo = %s ORDER BY id DESC LIMIT 1",
            (periodo,),
        )
        row = cur.fetchone()
        conn.close()
        if not row:
            return {"dados": {}, "periodo": periodo}
        dados = row[0] if isinstance(row[0], dict) else json.loads(row[0])
        return {"dados": dados, "periodo": periodo}
    except Exception as e:
        print("[DVP] GET erro:", e)
        print(traceback.format_exc())
        return {"erro": str(e)}


