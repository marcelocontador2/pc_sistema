@app.get("/periodos_importados/{tipo_relatorio}")
async def get_periodos_importados(tipo_relatorio: str):
    periodos = []
    if os.path.exists(UPLOAD_DIR):
        arquivos = glob.glob(os.path.join(UPLOAD_DIR, "*.csv"))
        for arq in arquivos:
            nome = os.path.basename(arq).upper()
            is_match = False
            if tipo_relatorio.upper() in nome: is_match = True
            elif "PATRIMONIAL" in tipo_relatorio.upper() and "BALANCO_PATRIMONIAL" in nome: is_match = True
            elif "FINANCEIRO" in tipo_relatorio.upper() and "BALANCO_FINANCEIRO" in nome: is_match = True
            elif "ORCAMENTARIO" in tipo_relatorio.upper() and "BALANCO_ORCAMENTARIO" in nome: is_match = True
            elif "BALANCETE" in tipo_relatorio.upper() and "BALANCETE" in nome: is_match = True
            elif "DFC" in tipo_relatorio.upper() and "DFC" in nome: is_match = True
            elif "DVP" in tipo_relatorio.upper() and "DVP" in nome: is_match = True
            elif "DMPL" in tipo_relatorio.upper() and "DMPL" in nome: is_match = True

            if is_match:
                partes = os.path.basename(arq).replace(".csv", "").split("_")
                ano = 2026
                p_tipo = "TRIMESTRE"
                p_valor = "1"
                for i, p in enumerate(partes):
                    if len(p) == 4 and p.isdigit():
                        ano = int(p)
                        if i + 2 < len(partes):
                            p_tipo = partes[i+1]
                            p_valor = partes[i+2]
                        break
                
                # O FORMATO QUE O FRONTEND ESPERA: "2026-TRIMESTRE-3"
                valor = f"{ano}-{p_tipo}-{p_valor}"
                periodos.append(valor)
                
    unicos = list(set(periodos))
    unicos.sort(reverse=True)
    
    # O Frontend procura por "data.periodos"
    return {"periodos": unicos}
@app.get("/analise_cruzada/{periodo}")
async def analise_cruzada(periodo: str):
    try:
        if not periodo or periodo.lower() == "undefined":
            periodo = "2026-TRIMESTRE-3"

        p_limpo = re.sub(r'[^A-Z0-9]', '_', periodo.upper())
        p_limpo = re.sub(r'_+', '_', p_limpo).strip('_')

        path_bp = os.path.join(UPLOAD_DIR, f"BALANCO_PATRIMONIAL_{p_limpo}.csv")

        if not os.path.exists(path_bp):
            for arq in os.listdir(UPLOAD_DIR):
                if arq.upper().startswith("BALANCO_PATRIMONIAL") and "2026" in arq and "TRIMESTRE_3" in arq:
                    path_bp = os.path.join(UPLOAD_DIR, arq)
                    break

        if not os.path.exists(path_bp):
            return {"erro": "Arquivo nao encontrado", "ativo_total": 0, "passivo_pl": 0, "diferenca": 0, "status": "ERRO"}

        ativo = 0.0
        passivo = 0.0

        # NOVO PARSER: acha a linha mestre do TOTAL REAL
        # Criterio: col0 == "TOTAL" E col3 == "TOTAL" E col1 == col4
        with open(path_bp, 'r', encoding='utf-8-sig', errors='ignore') as f:
            for linha in f:
                partes = [p.strip().replace('"', '') for p in linha.split(';')]
                if len(partes) >= 5:
                    c0 = partes[0].upper()
                    c3 = partes[3].upper() if len(partes) > 3 else ""
                    if c0 == "TOTAL" and c3 == "TOTAL":
                        v_ativo = _limpar_valor(partes[1])
                        v_passivo = _limpar_valor(partes[4])
                        # Confirma se bate (Ativo == Passivo)
                        if v_ativo > 0 and abs(v_ativo - v_passivo) < 0.05:
                            ativo = v_ativo
                            passivo = v_passivo
                            break

        # Fallback: se nao achou linha mestre, pega o MAIOR total valido
        if ativo == 0:
            with open(path_bp, 'r', encoding='utf-8-sig', errors='ignore') as f:
                for linha in f:
                    partes = [p.strip().replace('"', '') for p in linha.split(';')]
                    if len(partes) >= 6:
                        c0 = partes[0].upper()
                        c3 = partes[3].upper()
                        if c0 == "TOTAL" and c3 == "TOTAL":
                            v_ativo = _limpar_valor(partes[1])
                            v_passivo = _limpar_valor(partes[4])
                            if v_ativo > ativo:
                                ativo = v_ativo
                                passivo = v_passivo

        diferenca = ativo - passivo
        status = "OK" if abs(diferenca) < 0.05 else "ERRO"

        return {
            "ativo_total": ativo,
            "passivo_pl": passivo,
            "diferenca": diferenca,
            "status": status,
            "arquivo": os.path.basename(path_bp)
        }
    except Exception as e:
        return {"erro": str(e), "ativo_total": 0, "passivo_pl": 0, "diferenca": 0, "status": "ERRO"}
