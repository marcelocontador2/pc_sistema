# FUNÇÕES AUXILIARES BLINDADAS
# ==========================================
def _limpar_valor(texto):
    if not texto: return 0.0
    texto = str(texto).upper().replace("R$", "").replace(" ", "").strip()
    if not texto or texto == '-': return 0.0
    mult = -1.0 if texto.endswith('C') else 1.0
    texto = texto.replace("C", "").replace("D", "")
    if ',' in texto and '.' in texto:
        texto = texto.replace(".", "").replace(",", ".")
    elif ',' in texto:
        texto = texto.replace(",", ".")
    try:
        return float(texto) * mult
    except:
        return 0.0

